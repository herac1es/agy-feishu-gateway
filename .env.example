# 个人独立飞书自建应用凭据（通过飞书开放平台应用可用范围与事件权限隔离）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 飞书域名: feishu (https://open.feishu.cn) 或 lark (https://open.larksuite.com)
FEISHU_DOMAIN=feishu

# 群聊是否要求 @机器人 才触发（false=只要机器人被拉入群并开通群消息权限即直接响应）
FEISHU_GROUP_REQUIRE_MENTION=false

# 新建会话的默认工作目录（留空则自动使用 ~/.agy-feishu-gateway-workspace；可用 /cwd 动态切换）
DEFAULT_CWD=

# Antigravity CLI 可执行文件与可选默认模型/思考强度
AGY_BIN=agy
AGY_MODEL=
AGY_THOUGHT_LEVEL=

# 会话映射与入站附件存储目录
DATA_DIR=.data

# 飞书流式卡片刷新节流间隔（毫秒）
CARD_UPDATE_INTERVAL_MS=1200
